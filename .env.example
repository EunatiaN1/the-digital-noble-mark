# Local XRPL network. Mainnet is not supported by this app.
XRPL_NETWORK=testnet

# Leave false to enable the XRPL Testnet wallet workflow.
SPAZA_DEMO_MODE=false

# Keep the API bound to this computer.
API_HOST=127.0.0.1
API_PORT=8000

# The local API key is created by `python cli.py init` and stored in .env.
# Never commit the generated key or XRPL_SEED.
